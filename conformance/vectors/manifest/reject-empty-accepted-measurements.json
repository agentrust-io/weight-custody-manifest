{
  "id": "reject-empty-accepted-measurements",
  "level": "L1",
  "kind": "manifest",
  "description": "At least one accepted serving-image measurement is required, otherwise no serving stack could ever satisfy the release gate.",
  "expect": "reject",
  "code": "WCM-L1-0005",
  "reject_reason": "accepted_measurements must contain at least one entry",
  "schema_expressible": true,
  "manifest": {
    "manifest_version": "1.0",
    "weights_hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "builder": {
      "identity": "example-builder",
      "signing_key": "ed25519:builder-key"
    },
    "release_terms": {
      "license": "customer-deployment-agreement-ref:CDA-2026-0001",
      "permitted_derivatives": "fine-tune-only, no re-export of base weights",
      "permitted_environments": [
        "attested-enclave"
      ]
    },
    "release_policy": {
      "required_assurance_tier": "hardware-attested",
      "required_hw_platform": [
        "amd-sev-snp"
      ],
      "required_serving_image": {
        "signer": "ed25519:builder-key",
        "release_rule": "prefer-current",
        "accepted_measurements": []
      }
    },
    "custody": {
      "custodian": "example-custodian",
      "custodian_type": "customer-self-custody",
      "kbs_image": {
        "measurement": "sha256:4444444444444444444444444444444444444444444444444444444444444444",
        "signer": "ed25519:custodian-key"
      },
      "enclave_id": "did:example:enclave-01",
      "attestation_cadence": "24h"
    }
  }
}
