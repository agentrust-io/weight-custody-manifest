        "signer": "ed25519:custodian-key"
      },
      "enclave_id": "did:example:enclave-01",
      "attestation_cadence": "24h"
    },
    "derived_from": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "rights_holder": {
      "base": "example-builder",
      "derivative": "example-customer"
    }
  }
